#!/usr/bin/env python3
"""
ChronoReplay — Single-File Standalone Relay & Engine Artifact
Zero-Dependency Event-Sourced State & Time Machine Engine

This self-contained script bundles the event definition, validation,
append-only SQLite event store, deterministic state reducer, subscriber relay,
and time-travel / append-only restoration capabilities into a single,
independently runnable Python file using ONLY Python Standard Library.

Run independently with:
    python3 artifacts/relay-single.py
"""

import copy
from dataclasses import dataclass, field
from datetime import datetime, timezone
import hashlib
import json
import os
import sqlite3
import sys
from typing import Any, Callable, Dict, List, Optional
import uuid


# =====================================================================
# 1. EVENT MODEL
# =====================================================================

ALLOWED_EVENT_TYPES = {
    "user.created",
    "user.updated",
    "user.deleted",
    "user.status_changed",
    "balance.added",
    "order.created",
    "order.updated",
    "payment.completed",
    "state.restored",
    "file.created",
    "file.modified",
    "file.deleted",
}


@dataclass(frozen=True)
class Event:
    """Immutable event model."""
    id: str
    type: str
    timestamp: str
    data: Dict[str, Any] = field(default_factory=dict)

    @classmethod
    def create(cls, event_type: str, data: Optional[Dict[str, Any]] = None, timestamp: Optional[str] = None) -> "Event":
        if timestamp is None:
            timestamp = datetime.now(timezone.utc).isoformat()
        return cls(
            id=str(uuid.uuid4()),
            type=event_type,
            timestamp=timestamp,
            data=data or {},
        )

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "type": self.type,
            "timestamp": self.timestamp,
            "data": self.data,
        }

    @classmethod
    def from_dict(cls, data_dict: Dict[str, Any]) -> "Event":
        return cls(
            id=str(data_dict["id"]),
            type=str(data_dict["type"]),
            timestamp=str(data_dict["timestamp"]),
            data=data_dict.get("data", {}),
        )


# =====================================================================
# 2. VALIDATOR
# =====================================================================

class EventValidator:
    """Validates schemas and payload integrity."""

    @staticmethod
    def validate(event: Event) -> None:
        if not isinstance(event, Event):
            raise ValueError("Expected an Event instance.")

        if not event.id or not isinstance(event.id, str):
            raise ValueError("Event ID must be a non-empty string.")

        if event.type not in ALLOWED_EVENT_TYPES:
            raise ValueError(f"Invalid event type: {event.type}")

        if not event.timestamp or not isinstance(event.timestamp, str):
            raise ValueError("Event timestamp must be a non-empty ISO string.")

        if not isinstance(event.data, dict):
            raise ValueError("Event data must be a dictionary.")

        # Specific type validations
        d = event.data
        if event.type == "user.created":
            if "name" not in d or not str(d["name"]).strip():
                raise ValueError("user.created requires a non-empty 'name'.")
        elif event.type == "balance.added":
            amount = d.get("amount")
            if amount is None or not isinstance(amount, (int, float)) or amount <= 0:
                raise ValueError("balance.added requires a positive 'amount'.")
        elif event.type == "order.created":
            amount = d.get("total_amount", d.get("amount"))
            if amount is None or not isinstance(amount, (int, float)) or amount < 0:
                raise ValueError("order.created requires a valid numeric total amount.")
        elif event.type == "state.restored":
            if "source_event_number" not in d and "source_event_id" not in d:
                raise ValueError("state.restored requires 'source_event_number' or 'source_event_id'.")


# =====================================================================
# 3. SQLITE EVENT STORE
# =====================================================================

class EventStore:
    """Append-only SQLite event store with SHA-256 verification."""

    def __init__(self, db_path: str = ":memory:"):
        self.db_path = db_path
        self._conn = sqlite3.connect(self.db_path)
        self._init_db()

    def _init_db(self) -> None:
        cursor = self._conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS events (
                sequence_number INTEGER PRIMARY KEY AUTOINCREMENT,
                id TEXT UNIQUE NOT NULL,
                type TEXT NOT NULL,
                timestamp TEXT NOT NULL,
                data TEXT NOT NULL,
                hash TEXT NOT NULL
            )
        """)
        self._conn.commit()

    def _compute_hash(self, event: Event, seq: int) -> str:
        raw = f"{seq}:{event.id}:{event.type}:{event.timestamp}:{json.dumps(event.data, sort_keys=True)}"
        return hashlib.sha256(raw.encode("utf-8")).hexdigest()

    def save(self, event: Event) -> int:
        return self.append(event)

    def append(self, event: Event) -> int:
        EventValidator.validate(event)
        cursor = self._conn.cursor()
        cursor.execute("SELECT MAX(sequence_number) FROM events")
        row = cursor.fetchone()
        next_seq = (row[0] or 0) + 1
        h = self._compute_hash(event, next_seq)
        cursor.execute(
            "INSERT INTO events (sequence_number, id, type, timestamp, data, hash) VALUES (?, ?, ?, ?, ?, ?)",
            (next_seq, event.id, event.type, event.timestamp, json.dumps(event.data), h),
        )
        self._conn.commit()
        return next_seq

    def get_all(self) -> List[Event]:
        cursor = self._conn.cursor()
        cursor.execute("SELECT id, type, timestamp, data FROM events ORDER BY sequence_number ASC")
        rows = cursor.fetchall()
        return [
            Event(id=r[0], type=r[1], timestamp=r[2], data=json.loads(r[3]))
            for r in rows
        ]

    def get(self, event_id: str) -> Optional[Event]:
        cursor = self._conn.cursor()
        cursor.execute("SELECT id, type, timestamp, data FROM events WHERE id = ?", (event_id,))
        r = cursor.fetchone()
        if not r:
            return None
        return Event(id=r[0], type=r[1], timestamp=r[2], data=json.loads(r[3]))

    def count(self) -> int:
        cursor = self._conn.cursor()
        cursor.execute("SELECT COUNT(*) FROM events")
        return cursor.fetchone()[0]

    def clear(self) -> None:
        cursor = self._conn.cursor()
        cursor.execute("DELETE FROM events")
        self._conn.commit()


# =====================================================================
# 4. DETERMINISTIC STATE REDUCER & ENGINE
# =====================================================================

class StateEngine:
    """Computes pure state by sequentially reducing events."""

    def __init__(self):
        self.state = {
            "users": {},
            "orders": {},
            "system": {"version": 1, "last_updated": None},
            "files": {},
        }
        self._snapshots = []
        self._event_id_to_snapshot = {}
        self._event_count = 0

    def apply(self, event: Event) -> None:
        EventValidator.validate(event)
        t = event.type
        d = event.data

        if t == "user.created":
            uid = d.get("user_id", f"USR-{len(self.state['users']) + 1:04d}")
            self.state["users"][uid] = {
                "id": uid,
                "name": d.get("name", "Unknown"),
                "email": d.get("email", ""),
                "status": d.get("status", "ACTIVE"),
                "balance": 0.0,
            }
        elif t == "user.updated":
            uid = d.get("user_id")
            if uid in self.state["users"]:
                if "name" in d:
                    self.state["users"][uid]["name"] = d["name"]
                if "email" in d:
                    self.state["users"][uid]["email"] = d["email"]
        elif t == "user.status_changed":
            uid = d.get("user_id")
            if uid in self.state["users"]:
                self.state["users"][uid]["status"] = d.get("status", "ACTIVE")
        elif t == "user.deleted":
            uid = d.get("user_id")
            if uid in self.state["users"]:
                self.state["users"][uid]["status"] = "DELETED"
        elif t == "balance.added":
            uid = d.get("user_id")
            amt = float(d.get("amount", 0.0))
            if uid in self.state["users"]:
                self.state["users"][uid]["balance"] += amt
        elif t == "order.created":
            oid = d.get("order_id", f"ORD-{len(self.state['orders']) + 1:04d}")
            self.state["orders"][oid] = {
                "id": oid,
                "user_id": d.get("user_id", "System"),
                "total_amount": float(d.get("total_amount", d.get("amount", 0.0))),
                "status": d.get("status", "PENDING"),
                "items": d.get("items", []),
            }
        elif t == "order.updated":
            oid = d.get("order_id")
            if oid in self.state["orders"]:
                for k, v in d.items():
                    if k != "order_id":
                        self.state["orders"][oid][k] = v
        elif t == "payment.completed":
            oid = d.get("order_id")
            uid = d.get("user_id")
            amt = float(d.get("amount", 0.0))
            if oid and oid in self.state["orders"]:
                self.state["orders"][oid]["status"] = "PAID"
            if uid and uid in self.state["users"]:
                self.state["users"][uid]["balance"] -= amt
        elif t == "state.restored":
            src_id = d.get("source_event_id")
            if src_id and src_id in self._event_id_to_snapshot:
                self.state = copy.deepcopy(self._event_id_to_snapshot[src_id])
            else:
                src_num = d.get("source_event_number")
                if src_num and 1 <= src_num <= len(self._snapshots):
                    self.state = copy.deepcopy(self._snapshots[src_num - 1])

        self.state["system"]["last_updated"] = event.timestamp
        self._event_count += 1
        curr_snap = copy.deepcopy(self.state)
        self._snapshots.append(curr_snap)
        if event.id:
            self._event_id_to_snapshot[event.id] = curr_snap


class ReplayEngine:
    """Replays events to compute past or present states."""

    def __init__(self, store: EventStore):
        self.store = store

    def replay_all(self) -> Dict[str, Any]:
        engine = StateEngine()
        for e in self.store.get_all():
            engine.apply(e)
        return engine.state

    def replay_until(self, event_number: int) -> Dict[str, Any]:
        engine = StateEngine()
        events = self.store.get_all()
        for e in events[:event_number]:
            engine.apply(e)
        return engine.state


# =====================================================================
# 5. SUBSCRIBER RELAY
# =====================================================================

class EventRelay:
    """PubSub distribution for event subscribers."""

    def __init__(self):
        self._subscribers: List[Callable[[Event], None]] = []

    def subscribe(self, subscriber: Callable[[Event], None]) -> None:
        if not callable(subscriber):
            raise ValueError("Subscriber must be callable.")
        if subscriber not in self._subscribers:
            self._subscribers.append(subscriber)

    def unsubscribe(self, subscriber: Callable[[Event], None]) -> None:
        if subscriber in self._subscribers:
            self._subscribers.remove(subscriber)

    def publish(self, event: Event) -> int:
        EventValidator.validate(event)
        for s in self._subscribers:
            s(event)
        return len(self._subscribers)


# =====================================================================
# 6. STANDALONE UNIFIED ENGINE
# =====================================================================

class ChronoReplay:
    """High-level facade coordinating store, relay, and replay."""

    def __init__(self, db_path: str = ":memory:"):
        self.store = EventStore(db_path)
        self.relay = EventRelay()
        self.replayer = ReplayEngine(self.store)

    def publish_event(self, event_type: str, data: Dict[str, Any]) -> Event:
        event = Event.create(event_type, data)
        self.store.append(event)
        self.relay.publish(event)
        return event

    def rewind(self, step_number: int) -> Dict[str, Any]:
        return self.replayer.replay_until(step_number)

    def restore_state(self, source_step: int, reason: Optional[str] = None) -> Event:
        data = {"source_event_number": source_step}
        if reason:
            data["reason"] = reason
        return self.publish_event("state.restored", data)

    def get_current_state(self) -> Dict[str, Any]:
        return self.replayer.replay_all()


# =====================================================================
# SELF-TEST & VERIFICATION CLI
# =====================================================================

def run_self_test() -> bool:
    print("=" * 60)
    print("🚀 ChronoReplay Single-File Standalone Self-Test")
    print("=" * 60)

    engine = ChronoReplay(":memory:")
    received = []
    engine.relay.subscribe(lambda e: received.append(e.type))

    # 1. Create User
    print("1. Creating user...")
    e1 = engine.publish_event("user.created", {"user_id": "USR-0001", "name": "Rahul Verma", "email": "rahul@example.com"})
    assert engine.store.count() == 1

    # 2. Add Balance
    print("2. Adding balance ₹500...")
    e2 = engine.publish_event("balance.added", {"user_id": "USR-0001", "amount": 500.0})
    state_after_deposit = engine.get_current_state()
    assert state_after_deposit["users"]["USR-0001"]["balance"] == 500.0

    # 3. Create Order
    print("3. Creating order ₹200...")
    e3 = engine.publish_event("order.created", {"order_id": "ORD-0001", "user_id": "USR-0001", "total_amount": 200.0})

    # 4. Complete Payment
    print("4. Completing payment ₹200...")
    e4 = engine.publish_event("payment.completed", {"order_id": "ORD-0001", "user_id": "USR-0001", "amount": 200.0})
    state_after_payment = engine.get_current_state()
    assert state_after_payment["users"]["USR-0001"]["balance"] == 300.0
    assert state_after_payment["orders"]["ORD-0001"]["status"] == "PAID"

    # 5. Non-Destructive Rewind Test
    print("5. Testing Non-Destructive Rewind to Step 2 (Deposit)...")
    rewound_state = engine.rewind(2)
    assert rewound_state["users"]["USR-0001"]["balance"] == 500.0
    assert "ORD-0001" not in rewound_state["orders"]
    assert engine.store.count() == 4  # All 4 events still preserved!

    # 6. Append-Only Restore Test
    print("6. Testing Append-Only Restore from Step 2...")
    engine.restore_state(2, reason="Audit rollback test")
    assert engine.store.count() == 5  # 5th event is state.restored
    restored_state = engine.get_current_state()
    assert restored_state["users"]["USR-0001"]["balance"] == 500.0
    assert "ORD-0001" not in restored_state["orders"]

    print("=" * 60)
    print(f"✅ ALL VERIFICATION CHECKS PASSED ({len(received)} events relayed)")
    print("=" * 60)
    return True


if __name__ == "__main__":
    success = run_self_test()
    sys.exit(0 if success else 1)
